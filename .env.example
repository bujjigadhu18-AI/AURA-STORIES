# Business Contact & WhatsApp Webhook / Direct
VITE_WHATSAPP_NUMBER=919876543210
VITE_CONTACT_EMAIL=inquiries@aurastories.in

# Web Analytics (Optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
